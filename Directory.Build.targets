<Project>
  <ItemDefinitionGroup Condition="'$(RudpRoot)' != ''">
    <ClCompile>
      <AdditionalIncludeDirectories>$(RudpRoot)MultiSocketRUDP\MultiSocketRUDPClient;$(RudpRoot)MultiSocketRUDP\Logger;$(RudpRoot)external\CommonCode\Common;$(RudpRoot)external\CommonCode\Common\json-develop\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="ValidateRudpClientDependency" BeforeTargets="PrepareForBuild" Condition="'$(RudpRoot)' != ''">
    <Error Condition="'$(Platform)' != 'x64'" Text="MultiSocketRUDP client integration requires x64." />
    <Error Condition="!Exists('$(RudpRoot)external\CommonCode\Common\NetServerSerializeBuffer.h')" Text="Initialize dependencies: git submodule update --init --recursive" />
  </Target>
  <Target Name="BuildRudpClientDependency" BeforeTargets="PrepareForBuild" DependsOnTargets="ValidateRudpClientDependency" Condition="'$(MSBuildProjectName)' == 'ActionRPGClient' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RudpClientProjects Include="$(RudpRoot)MultiSocketRUDP\MultiSocketRUDPClient\MultiSocketRUDPClient.vcxproj" />
      <RudpClientProjects Include="$(RudpRoot)MultiSocketRUDP\Logger\Logger.vcxproj" />
    </ItemGroup>
    <MSBuild Projects="@(RudpClientProjects)" Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64;PlatformToolset=v143;SolutionDir=$(RudpRoot)MultiSocketRUDP\"
             BuildInParallel="true" />
  </Target>
</Project>
